<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EnglishPractice.Mobile.Views.LoginPage"
             Title="English Practice">
    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="16" VerticalOptions="Center">
            <Label Text="🗣️" FontSize="64" HorizontalOptions="Center"/>
            <Label Text="English Practice" FontSize="28" HorizontalOptions="Center" FontAttributes="Bold"/>
            <Label Text="AI Speaking Coach" FontSize="16" HorizontalOptions="Center" TextColor="Gray"/>

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,8"/>

            <Entry Placeholder="Username" Text="{Binding Username}" ReturnType="Next"/>
            <Entry Placeholder="Email" Text="{Binding Email}" IsVisible="{Binding IsRegistering}" Keyboard="Email" ReturnType="Next"/>
            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" ReturnType="Go"
                   ReturnCommand="{Binding SubmitCommand}"/>

            <Label Text="{Binding ErrorMessage}" TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={x:StaticResource StringNotEmptyConverter}}"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center"/>

            <Button Text="{Binding IsRegistering, Converter={x:StaticResource BoolToRegisterLoginConverter}}"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding IsBusy, Converter={x:StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#1976D2" TextColor="White" CornerRadius="8"/>

            <Button Text="{Binding IsRegistering, Converter={x:StaticResource BoolToToggleModeConverter}}"
                    Command="{Binding ToggleModeCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
