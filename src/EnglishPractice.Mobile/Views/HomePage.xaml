<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EnglishPractice.Mobile.ViewModels"
             xmlns:models="clr-namespace:EnglishPractice.Mobile.Models"
             x:Class="EnglishPractice.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Choose Scenario">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="16,16,16,8" BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#0D47A1}">
            <Label Text="🗣️ English Practice" TextColor="White" FontSize="22" FontAttributes="Bold"/>
            <Label Text="Choose a scenario to practice" TextColor="#B3E5FC" FontSize="13"/>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Scenarios}" Margin="8">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Scenario">
                    <Border Stroke="{AppThemeBinding Light=LightGray, Dark=#444}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Margin="0">
                        <VerticalStackLayout Padding="12" Spacing="6">
                            <Label Text="{Binding Icon}" FontSize="36" HorizontalOptions="Center"/>
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Description}" FontSize="11" TextColor="Gray"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                            <Label Text="{Binding Difficulty}" FontSize="10"
                                   TextColor="{AppThemeBinding Light=DarkGreen, Dark=LightGreen}"
                                   HorizontalOptions="Center"/>
                            <Button Text="Start"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=StartScenarioCommand}"
                                    CommandParameter="{Binding .}"
                                    HeightRequest="34" FontSize="13"
                                    BackgroundColor="#1976D2" TextColor="White" CornerRadius="6"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
